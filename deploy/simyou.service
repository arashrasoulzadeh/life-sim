[Unit]
Description=SimYou — a life that runs itself
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Adjust User and the three paths to match where you cloned the repo and which
# user owns it. The defaults assume:  git clone … /home/ubuntu/life-sim  as ubuntu
User=ubuntu
WorkingDirectory=/home/ubuntu/life-sim
EnvironmentFile=/home/ubuntu/life-sim/.env
# `env node` finds node whether it's /usr/bin/node (apt/NodeSource) or
# /usr/local/bin/node (tarball) — both are on systemd's default PATH
ExecStart=/usr/bin/env node /home/ubuntu/life-sim/server.mjs
Restart=always
RestartSec=3

# minimal hardening that still allows running from a home directory
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
