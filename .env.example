# Copy to .env and adjust. Loaded by systemd (EnvironmentFile) or `node --env-file=.env server.mjs`.

# The one life this instance runs. Keep it fixed — changing it starts a different life.
SIMYOU_SEED=777

SIMYOU_PORT=5173

# Absolute paths, both writable by the service User. Point them at the clone dir.
SIMYOU_DB=/home/ubuntu/life-sim/simyou.db
SIMYOU_SITES=/home/ubuntu/life-sim/sites.json

# Start/end-of-day conversations. Leave the key blank to use the offline voice
# (the life still talks and rearranges rooms, just without the model).
SIMYOU_GAPGPT_KEY=
SIMYOU_GAPGPT_BASE=https://api.gapgpt.app/v1
SIMYOU_GAPGPT_MODEL=gpt-4o-mini
SIMYOU_DIALOGUE=on
